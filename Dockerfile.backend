FROM python:3.12-slim-trixie AS qemu-build

ARG QEMU_VERSION=11.0.5
ARG BUILD_JOBS=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        ninja-build \
        curl \
        xz-utils \
        ca-certificates \
        libglib2.0-dev \
        libpixman-1-dev \
        libslirp-dev \
        libfdt-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
    meson==1.10.0 \
    pycotap==1.3.1

WORKDIR /tmp/qemu

RUN curl --fail --location --retry 3 \
        "https://download.qemu.org/qemu-${QEMU_VERSION}.tar.xz" \
        -o qemu.tar.xz \
    && tar -xJf qemu.tar.xz --strip-components=1 \
    && mkdir build \
    && cd build \
    && ../configure \
        --prefix=/opt/qemu \
        --target-list=x86_64-softmmu \
        --enable-slirp \
        --disable-gtk \
        --disable-sdl \
        --disable-vnc \
        --disable-docs \
        --disable-werror \
    && ninja -j "${BUILD_JOBS}" \
    && ninja install


FROM python:3.12-slim-trixie AS backend

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/qemu/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        libglib2.0-0t64 \
        libpixman-1-0 \
        libslirp0 \
        libfdt1 \
        libstdc++6 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=qemu-build /opt/qemu /opt/qemu

WORKDIR /app

COPY requirements.txt .
RUN python -m pip install --no-cache-dir -r requirements.txt

COPY main.py .
COPY back/app ./back/app
COPY scripts/boot.sh ./scripts/boot.sh

RUN sed -i 's/\r$//' scripts/boot.sh

RUN qemu-system-x86_64 --version \
    && qemu-img --version

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]